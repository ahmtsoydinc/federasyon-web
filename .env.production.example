# =============================================
# TSHF Web — Üretim Ortamı Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve doldurun
# =============================================

# Veritabanı (SQLite — mutlak yol kullanın)
DATABASE_URL="file:/home/tshf/app/tshf.db"

# Güvenlik — güçlü rastgele değer kullanın
# Oluşturmak için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="BURAYA_GUCLU_RASTGELE_DEGER_YAZIN"

# Site adresi (sonunda / olmadan)
SITE_URL="https://tshf.org.tr"
NEXTAUTH_URL="https://tshf.org.tr"

# ─── SMTP E-posta Ayarları ───────────────────
# Gmail için: Google Hesabı → Güvenlik → 2 adımlı doğrulama → Uygulama Şifresi
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="sitenin-emaili@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="TSHF <sitenin-emaili@gmail.com>"

# ─── Alternatif SMTP (Yandex) ───────────────
# SMTP_HOST="smtp.yandex.com"
# SMTP_PORT="587"
# SMTP_USER="bilgi@tshf.org.tr"
# SMTP_PASS="sifrEniz"
# SMTP_FROM="TSHF <bilgi@tshf.org.tr>"
